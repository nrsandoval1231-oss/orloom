# Preserve the executed observation script, including its final blank line.
suite-observe-attempt.cjs whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
# Raw Git/npm diagnostics contain trailing spaces; never rewrite observed bytes.
executions/*.log whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
