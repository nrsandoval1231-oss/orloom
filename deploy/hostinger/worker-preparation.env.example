# Disabled preparation example only. Do not use as a complete app or worker environment.
ORLOOM_WORKER_MODE=
ORLOOM_WORKER_APPROVED_TASK_FILE=
ORLOOM_WORKER_TOKEN_FILE=
ORLOOM_DATABASE_URL_FILE=
ORLOOM_GITHUB_PRIVATE_KEY_FILE=/etc/orloom/credentials/github-app-private-key
ORLOOM_DEEPSEEK_API_KEY_FILE=
ORLOOM_R2_ACCESS_KEY_ID_FILE=
ORLOOM_R2_SECRET_ACCESS_KEY_FILE=
ORLOOM_CAPACITY_SLOTS=0
ORLOOM_CAPACITY_EVIDENCE_VERIFIED=false
ORLOOM_MAX_LANES=1
ORLOOM_INTEGRATION_ENABLED=false
ORLOOM_DELIVERY_ENABLED=false
