{
  "name": "orloom-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/apps/control-plane/src/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/apps/worker/src/main.js",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@octokit/app": "16.1.4",
    "@openai/codex-sdk": "0.162.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "24.10.0",
    "@types/pg": "^8.15.6",
    "typescript": "5.9.3"
  }
}
